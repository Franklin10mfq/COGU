import sys, shutil, os
sys.path.insert(0, 'COGU_library')
from examples.astrobee_simple import *

# astrobee_simple.py ya ejecuta solve_trajectory() (T=50, nx=13) y valida resultados.
print("Test OK: solve_trajectory ejecutado correctamente via astrobee_simple import.")

# --- Test generate_c=True con problema pequenio ---
# CVXPYgen requiere CVXPY 1.8 DPP expansion. Con T=50/nx=13 la matriz tiene ~41M
# entradas y agota RAM. T<=10 con nx<=6 entra sin problemas.
import sympy as sp
import numpy as np
from sympy_cvx_converter import solve_trajectory

rx, vx = sp.symbols('rx vx')
ax = sp.symbols('ax')
out_dir = 'c_output_test'
if os.path.exists(out_dir):
    shutil.rmtree(out_dir)

print("\nTest generate_c=True (T=5, nx=2)...")
solve_trajectory(
    states=[rx, vx], controls=[ax], dynamics=[vx, ax],
    start=np.array([[0.0],[0.0]]), end=np.array([[1.0],[0.0]]),
    T=5, tf=10.0, max_iter=3, verbose=False,
    generate_c=True, c_output_dir=out_dir
)
c_src = os.path.join(out_dir, 'solver', 'c', 'src')
assert os.path.isdir(c_src), "C source files not found"
print(f"C files generados en {c_src}/")
print("Test generate_c OK.")
